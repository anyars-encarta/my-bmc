{
  "openapi": "3.1.0",
  "info": {
    "title": "BMC HAMS API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/public/hosting-renewal/reference": {
      "servers": [{ "url": "/api" }],
      "post": {
        "summary": "Create a server-priced hosting renewal reference",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["quantityInMonths"],
                "properties": {
                  "quantityInMonths": { "type": "integer", "minimum": 1, "maximum": 36 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Server-priced renewal and payment reference",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reference": { "type": "string" },
                        "quantityInMonths": { "type": "integer" },
                        "exchangeRate": { "type": "number" },
                        "totalCediEquivalent": { "type": "number" },
                        "startDate": { "type": "string", "format": "date" },
                        "endDate": { "type": "string", "format": "date" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/public/hosting-renewal/confirm": {
      "servers": [{ "url": "/api" }],
      "post": {
        "summary": "Confirm a server-issued hosting renewal payment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["quantityInMonths", "totalCediEquivalent", "payment"],
                "properties": {
                  "quantityInMonths": { "type": "integer", "minimum": 1, "maximum": 36 },
                  "totalCediEquivalent": { "type": "number", "exclusiveMinimum": 0 },
                  "payment": {
                    "type": "object",
                    "required": ["reference", "amount", "currency"],
                    "properties": {
                      "reference": { "type": "string" },
                      "amount": { "type": "number" },
                      "currency": { "type": "string", "const": "GHS" },
                      "status": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Hosting renewal confirmed" },
          "400": { "description": "Invalid quote or payment" },
          "404": { "description": "No stored renewal matches the payment reference" },
          "409": { "description": "The stored renewal is not awaiting confirmation" }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Current authenticated profile",
        "responses": {
          "200": {
            "description": "Current user profile and permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List users",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 200 } },
          { "name": "sort", "in": "query", "schema": { "type": "string" } },
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "role", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponseEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/staff/{staffId}/assignments": {
      "get": {
        "summary": "Staff assignment history",
        "parameters": [
          { "$ref": "#/components/parameters/StaffId" }
        ],
        "responses": {
          "200": {
            "description": "Assignment history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AssignmentRecord" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a temporary or cover assignment",
        "parameters": [{ "$ref": "#/components/parameters/StaffId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TemporaryAssignmentRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Assignment created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AssignmentResponse" }
              }
            }
          }
        }
      }
    },
    "/staff/{staffId}/effective-unit": {
      "get": {
        "summary": "Resolve a staff member's effective unit on a date",
        "parameters": [
          { "$ref": "#/components/parameters/StaffId" },
          {
            "name": "on",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Effective assignment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "on": { "type": "string", "format": "date" },
                        "assignment": {
                          "oneOf": [
                            { "$ref": "#/components/schemas/AssignmentRecord" },
                            { "type": "null" }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/staff/{staffId}/transfers": {
      "post": {
        "summary": "Schedule a permanent staff transfer",
        "parameters": [{ "$ref": "#/components/parameters/StaffId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransferRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer scheduled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AssignmentResponse" }
              }
            }
          }
        }
      }
    },
    "/staff/{staffId}/deactivate": {
      "post": {
        "summary": "Deactivate a staff member and cancel future work",
        "parameters": [{ "$ref": "#/components/parameters/StaffId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StaffDeactivationRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Staff member deactivated" } }
      }
    },
    "/transfer-batches": {
      "get": {
        "summary": "List transfer batches",
        "responses": {
          "200": {
            "description": "Transfer batches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/TransferBatch" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a transfer batch draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransferBatchRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransferBatchResponse" }
              }
            }
          }
        }
      }
    },
    "/transfer-batches/{id}": {
      "patch": {
        "summary": "Edit a transfer batch draft",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransferBatchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransferBatchResponse" }
              }
            }
          }
        }
      }
    },
    "/transfer-batches/{id}/preview": {
      "get": {
        "summary": "Preview transfer batch coverage impact",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": {
            "description": "Coverage preview",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/TransferBatchPreview" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/transfer-batches/{id}/approve": {
      "post": {
        "summary": "Approve a transfer batch",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "Batch approved" } }
      }
    },
    "/transfer-batches/{id}/apply": {
      "post": {
        "summary": "Atomically apply an approved transfer batch",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "Batch applied" } }
      }
    },
    "/transfer-batches/{id}/cancel": {
      "post": {
        "summary": "Cancel an approved transfer batch",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Batch cancelled" },
          "404": { "description": "Batch not found" },
          "409": { "description": "Batch is not approved" }
        }
      }
    },
    "/unit-staffing-requirements": {
      "get": {
        "summary": "List minimum staffing requirements",
        "responses": {
          "200": {
            "description": "Staffing requirements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/StaffingRequirement" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a minimum staffing requirement",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StaffingRequirementRequest" }
            }
          }
        },
        "responses": { "201": { "description": "Requirement created" } }
      }
    },
    "/unit-staffing-requirements/{id}": {
      "patch": {
        "summary": "Update a minimum staffing requirement",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StaffingRequirementRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Requirement updated" } }
      },
      "delete": {
        "summary": "Delete a minimum staffing requirement",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": { "200": { "description": "Requirement deleted" } }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "StaffId": {
        "name": "staffId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "AssignmentRecord": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "orgUnitId": { "type": "string", "format": "uuid" },
          "unitName": { "type": "string" },
          "unitCode": { "type": "string" },
          "assignmentType": { "type": "string", "enum": ["PRIMARY", "TEMPORARY", "COVER"] },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": ["string", "null"], "format": "date" },
          "reason": { "type": "string" },
          "note": { "type": ["string", "null"] }
        }
      },
      "AssignmentResponse": {
        "type": "object",
        "properties": { "data": { "$ref": "#/components/schemas/AssignmentRecord" } }
      },
      "TemporaryAssignmentRequest": {
        "type": "object",
        "required": ["orgUnitId", "assignmentType", "effectiveFrom", "effectiveTo"],
        "properties": {
          "orgUnitId": { "type": "string", "format": "uuid" },
          "assignmentType": { "type": "string", "enum": ["TEMPORARY", "COVER"] },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": "string", "format": "date" },
          "reason": { "type": "string", "enum": ["SECONDMENT", "COVER"] },
          "note": { "type": "string", "maxLength": 1000 }
        }
      },
      "TransferRequest": {
        "type": "object",
        "required": ["toUnitId", "effectiveFrom"],
        "properties": {
          "toUnitId": { "type": "string", "format": "uuid" },
          "effectiveFrom": { "type": "string", "format": "date" },
          "reason": { "type": "string", "enum": ["TRANSFER", "RESHUFFLE", "PROMOTION", "RETURN"] },
          "note": { "type": "string", "maxLength": 1000 }
        }
      },
      "StaffDeactivationRequest": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "TransferBatchItemRequest": {
        "type": "object",
        "required": ["staffId", "toUnitId"],
        "properties": {
          "staffId": { "type": "string", "format": "uuid" },
          "toUnitId": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "enum": ["RESHUFFLE", "TRANSFER", "PROMOTION", "RETURN"] },
          "note": { "type": "string", "maxLength": 1000 }
        }
      },
      "TransferBatchRequest": {
        "type": "object",
        "required": ["title", "effectiveFrom", "items"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 150 },
          "effectiveFrom": { "type": "string", "format": "date" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/TransferBatchItemRequest" }
          }
        }
      },
      "TransferBatch": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "effectiveFrom": { "type": "string", "format": "date" },
          "status": { "type": "string", "enum": ["DRAFT", "APPROVED", "APPLIED", "CANCELLED"] },
          "items": { "type": "array", "items": { "type": "object" } }
        }
      },
      "TransferBatchResponse": {
        "type": "object",
        "properties": { "data": { "$ref": "#/components/schemas/TransferBatch" } }
      },
      "TransferBatchPreview": {
        "type": "object",
        "properties": {
          "batchId": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "effectiveFrom": { "type": "string", "format": "date" },
          "moves": { "type": "array", "items": { "type": "object" } },
          "coverage": { "type": "array", "items": { "type": "object" } }
        }
      },
      "StaffingRequirement": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "orgUnitId": { "type": "string", "format": "uuid" },
          "unitName": { "type": "string" },
          "unitCode": { "type": "string" },
          "shiftTypeId": { "type": "string", "format": "uuid" },
          "shiftName": { "type": "string" },
          "jobRoleId": { "type": ["string", "null"], "format": "uuid" },
          "roleName": { "type": ["string", "null"] },
          "minStaff": { "type": "integer", "minimum": 0 }
        }
      },
      "StaffingRequirementRequest": {
        "type": "object",
        "required": ["orgUnitId", "shiftTypeId", "minStaff"],
        "properties": {
          "orgUnitId": { "type": "string", "format": "uuid" },
          "shiftTypeId": { "type": "string", "format": "uuid" },
          "jobRoleId": { "type": ["string", "null"], "format": "uuid" },
          "minStaff": { "type": "integer", "minimum": 0 }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["page", "limit", "total", "totalPages", "hasMore"],
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "hasMore": { "type": "boolean" }
        }
      },
      "ProblemError": {
        "type": "object",
        "required": ["type", "title", "status", "error", "message", "requestId"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "error": { "type": "string" },
          "message": { "type": "string" },
          "code": { "type": "string" },
          "requestId": { "type": "string" },
          "details": {}
        }
      },
      "MePayload": {
        "type": "object",
        "required": ["user", "roles", "unitScopes", "permissions"],
        "properties": {
          "user": {
            "type": "object",
            "required": ["id", "name", "email", "status"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "status": { "type": "string" }
            }
          },
          "roles": { "type": "array", "items": { "type": "string" } },
          "unitScopes": { "type": "array", "items": { "type": "object" } },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      },
      "MeResponseEnvelope": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/MePayload" }
        }
      },
      "UserListResponseEnvelope": {
        "type": "object",
        "required": ["data", "pagination"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "email", "status", "roles", "permissions"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "status": { "type": "string" },
                "roles": { "type": "array", "items": { "type": "string" } },
                "permissions": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      }
    }
  }
}
