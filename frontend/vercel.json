{
  "rewrites": [
    {
      "source": "/api/public/:path*",
      "destination": "/api/proxy?path=public/:path*"
    },
    {
      "source": "/api/proxy",
      "destination": "/api/proxy"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/proxy?path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
